    a owl:ObjectProperty ;
    rdfs:label "communicates with" .

uhmo:manipulates
    a owl:ObjectProperty ;
    rdfs:label "manipulates" .

uhmo:grasps
    a owl:ObjectProperty ;
    rdfs:label "grasps" .

