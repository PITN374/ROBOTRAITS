    a owl:Class ;
    rdfs:label "Regulatory Agency" .

# ============================================================
# INFORMATION ENTITIES
# ============================================================

uhmo:Asset
    a owl:Class ;
    rdfs:label "Asset" .

uhmo:Service
    a owl:Class ;
    rdfs:label "Service" .

uhmo:Event
    a owl:Class ;
    rdfs:label "Event" .

uhmo:Transaction
    a owl:Class ;
    rdfs:label "Transaction" .

uhmo:Knowledge
    a owl:Class ;
    rdfs:label "Knowledge" .

uhmo:DigitalResource
    a owl:Class ;
    rdfs:label "Digital Resource" .

uhmo:TechnicalDocumentation
    a owl:Class ;
    rdfs:label "Technical Documentation" .

uhmo:CADModel
    a owl:Class ;
    rdfs:label "CAD Model" .

# ============================================================
# CORE RELATIONSHIPS
# ============================================================

uhmo:hasPart
    a owl:ObjectProperty ;
    rdfs:label "has part" .

uhmo:contains
    a owl:ObjectProperty ;
    rdfs:label "contains" .

uhmo:controls
    a owl:ObjectProperty ;
    rdfs:label "controls" .

uhmo:actuates
    a owl:ObjectProperty ;
    rdfs:label "actuates" .

uhmo:powers
    a owl:ObjectProperty ;
    rdfs:label "powers" .

uhmo:senses
    a owl:ObjectProperty ;
    rdfs:label "senses" .

