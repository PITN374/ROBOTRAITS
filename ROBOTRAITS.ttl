# ============================================================
# SOFTWARE SYSTEMS
# ============================================================

uhmo:MotionController
    a owl:Class ;
    rdfs:label "Motion Controller" .

uhmo:ManipulationPlanner
    a owl:Class ;
    rdfs:label "Manipulation Planner" .

uhmo:GraspPlanner
    a owl:Class ;
    rdfs:label "Grasp Planner" .

uhmo:AIModel
    a owl:Class ;
    rdfs:label "AI Model" .

uhmo:ReinforcementLearningModel
    a owl:Class ;
    rdfs:label "Reinforcement Learning Model" .

uhmo:DigitalTwin
    a owl:Class ;
