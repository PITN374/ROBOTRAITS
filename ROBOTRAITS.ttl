    a owl:Class ;
    rdfs:label "Control Software" .

# ============================================================
# ORGANIZATIONAL ENTITIES
# ============================================================

uhmo:Manufacturer
    a owl:Class ;
    rdfs:label "Manufacturer" .

uhmo:Supplier
    a owl:Class ;
    rdfs:label "Supplier" .

